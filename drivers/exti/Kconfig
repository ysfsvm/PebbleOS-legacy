menuconfig EXTI
    bool "External Interrupt"
    help
      External Interrupt Drivers

if EXTI

config EXTI_STM32
    bool "ST STM32"
    default y if SOC_STM32F4
    depends on GPIO_STM32
    help
      The stock firmware's EXTI calls, on the interrupt controllers of the
      STM32F4 GPIO ports.

module = DRIVER_EXTI
module-str = External Interrupt
source "subsys/logging/Kconfig.template.log_level"

endif # EXTI
