menuconfig FLASH
    bool "Flash"
    select CRC
    select TASK_WDT
    help
      Flash Drivers

if FLASH

config FLASH_OTP
    bool
    help
      Selected by drivers with a user one-time programmable area, see
      pbl_flash_otp_*().

config FLASH_SPI_NOR
    bool "SPI NOR"
    default DT_HAS_JEDEC_SPI_NOR_ENABLED
    select SPI_MEM
    select FLASH_OTP
    help
      Support for a JEDEC NOR flash on a SPI memory controller, found by
      its JEDEC ID among the supported parts and described by its SFDP
      tables and the part description.

config FLASH_S29VS
    bool "Spansion S29VS (FMC)"
    depends on HAL_STM32_STM32F439
    help
      Support for the Spansion S29VS parallel NOR flash on the STM32F439
      FMC, as found on the Pebble Time (snowy).

config FLASH_QEMU
    bool "QEMU External Flash"
    default DT_HAS_QEMU_PEBBLE_EXTFLASH_ENABLED
    depends on SOC_QEMU_PEBBLE
    help
      Support for the QEMU external flash peripheral.

config FLASH_POSIX
    bool "POSIX External Flash"
    default y if SOC_POSIX
    help
      External flash backed by a file on the host.

config FLASH_SHELL
    bool "Shell commands"
    default DRIVER_SHELL
    depends on SHELL
    help
      The flash shell command, to inspect, erase and test the flash.

config FLASH_SHELL_TEST
    bool "Test commands"
    depends on FLASH_SHELL
    help
      The flash read, fill, validate and erased_sectors commands, to dump
      and verify the flash from a host.

config FLASH_SHELL_STRESS
    bool "Stress and benchmark commands"
    default y
    depends on FLASH_SHELL
    help
      The flash stress and benchmark commands. The stress test writes the
      firmware update area.

config FLASH_LAYOUT_SNOWY
    bool "Pebble Time (snowy, spalding) stock flash layout"
    select FLASH_GUARD
    help
      Use the stock Pebble Time and Time Round external flash layout, keeping the stock
      bootloader's PRF, shared PRF storage and MFG info (with the boot FPGA
      bitstream) where they are.

config FLASH_GUARD
    bool "Guard regions the firmware does not own"
    help
      Refuse any erase or write that overlaps PRF, stock shared PRF
      storage or MFG info.

module = DRIVER_FLASH
module-str = Flash
source "subsys/logging/Kconfig.template.log_level"

endif # FLASH
