menuconfig DMA
    bool "DMA controllers"
    help
      DMA controller class (pbl/drivers/dma.h), selected by the drivers
      that move data through DMA channels.

if DMA

config DMA_SF32LB52
    bool "SiFli SF32LB52 DMA controller"
    default DT_HAS_SIFLI_SF32LB52_DMAC_ENABLED
    select CLK
    help
      The SF32LB52 HPSYS DMA controller (DMAC1).

config DMA_SF32LB52_IRQ_PRIO
    int "Interrupt priority"
    default 5
    depends on DMA_SF32LB52
    help
      Priority of the channel interrupts.

config DMA_STM32F4
    bool "ST STM32F4 DMA controller"
    default DT_HAS_ST_STM32_DMA_ENABLED
    select CLK
    help
      The STM32F4 DMA1 and DMA2 controllers.

config DMA_STM32F4_IRQ_PRIO
    int "Interrupt priority"
    default 14
    depends on DMA_STM32F4
    help
      Priority of the stream interrupts.

endif # DMA
