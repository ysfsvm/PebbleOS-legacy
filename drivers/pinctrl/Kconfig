menuconfig PINCTRL
    bool "Pin controllers"
    help
      Pin controller class (pbl/drivers/pinctrl.h), selected by the drivers
      that route peripheral signals to pins.

if PINCTRL

config PINCTRL_SF32LB52
    bool "SiFli SF32LB52 pin controller"
    default DT_HAS_SIFLI_SF32LB52_PINCTRL_ENABLED
    help
      Pin multiplexer and pad configuration of the SiFli SF32LB52 HPSYS
      pads.

config PINCTRL_SF32LB52_OUTPUT_LOW
    bool
    depends on PINCTRL_SF32LB52
    help
      Pins of a state can be driven low, through the GPIO driver.

config PINCTRL_STM32
    bool "ST STM32F4 pin controller"
    default DT_HAS_ST_STM32F429_PINCTRL_ENABLED
    depends on GPIO_STM32
    help
      Alternate functions and pad configuration of the STM32F4 GPIO
      ports.

config PINCTRL_SHELL
    bool "Pin controller shell commands"
    default DRIVER_SHELL
    depends on SHELL
    help
      The pinctrl shell command, to dump the pad registers of every pin
      controller.

endif # PINCTRL
