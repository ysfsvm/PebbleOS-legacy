menuconfig DISPLAY
    bool "Display"
    help
      Display Drivers

if DISPLAY

config DISPLAY_SF32LB_LCDC
    bool "SiFli SF32LB LCD controller"
    default DT_HAS_SIFLI_SF32LB52_LCDC_ENABLED
    depends on SOC_SF32LB52
    select CLK
    select PANEL
    select PINCTRL
    select RESET
    help
      Support for the SiFli SF32LB LCD controller, driving a JDI
      memory-in-pixel panel.

config DISPLAY_SF32LB_LCDC_IRQ_PRIO
    int "Interrupt priority"
    default 5
    depends on DISPLAY_SF32LB_LCDC
    help
      Priority of the controller interrupt.

config DISPLAY_SHARP_LS013B7DH01
    bool "Sharp LS013B7DH01"
    default DT_HAS_SHARP_LS013B7DH01_ENABLED
    select PWM
    select SPI
    help
      Support for the Sharp LS013B7DH01 memory LCD.

config DISPLAY_ICE40LP_STM32
    bool "iCE40LP framebuffer FPGA (STM32)"
    depends on SOC_STM32F4
    default y if HAL_STM32_STM32F439
    select DMA
    select UZLIB
    help
      Support for the Pebble Time display, driven through an iCE40LP
      framebuffer FPGA on an STM32F4 SPI.

config DISPLAY_ICE40LP_ROUND
    bool "iCE40LP round panel"
    depends on DISPLAY_ICE40LP_STM32 && PLATFORM_ROUND
    help
      The FPGA drives the round panel of the Pebble Time Round: it takes
      rows of the packed round framebuffer, shifted by the factory display
      offsets, instead of columns.

config DISPLAY_ICE40LP_STM32_FAST_LINE
    bool "Optimize the line packing for speed"
    depends on DISPLAY_ICE40LP_STM32
    help
      Compile the function that packs each panel line, which runs in the
      DMA interrupt for every line of every frame, at -O3 instead of the
      firmware's -Os.

config DISPLAY_ICE40LP_STM32_BUSY_EDGE
    bool "Wake on the FPGA's BUSY edge before a frame"
    depends on DISPLAY_ICE40LP_STM32
    help
      Before a frame, sleep until BUSY's falling edge instead of polling
      BUSY with 1 ms sleeps. Without an edge within 40 ms it polls as
      before.

config DISPLAY_QEMU
    bool "QEMU Framebuffer Display"
    default DT_HAS_QEMU_PEBBLE_DISPLAY_ENABLED
    depends on SOC_QEMU_PEBBLE
    help
      Support for the QEMU framebuffer display peripheral.

config DISPLAY_SDL
    bool "SDL window"
    default y if SOC_POSIX
    select SDL
    help
      Display shown in an SDL window on the host of a native build.

if DISPLAY_SDL

config DISPLAY_SDL_WIDTH
    int "SDL display width"
    help
      Width of the SDL display, in pixels.

config DISPLAY_SDL_HEIGHT
    int "SDL display height"
    help
      Height of the SDL display, in pixels.

config DISPLAY_SDL_MONO
    bool "SDL display is monochrome"
    help
      The SDL display takes a 1-bit framebuffer, 8-bit color otherwise.

config DISPLAY_SDL_ROUND
    bool "SDL display is round"
    help
      The SDL display hides the pixels outside the circle of the
      LS013B7DD02 panel.

endif # DISPLAY_SDL

config DISPLAY_SHELL
    bool "Shell commands"
    default DRIVER_SHELL
    depends on SHELL
    help
      The display shell command, to show the display and turn its panel on
      or off.

module = DRIVER_DISPLAY
module-str = Display
source "subsys/logging/Kconfig.template.log_level"

endif # DISPLAY
