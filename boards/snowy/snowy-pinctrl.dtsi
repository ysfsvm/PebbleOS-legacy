// Every option of a pin is written, so each UART and SPI pin names its speed: 50 MHz (slew-rate 2).

&pinctrl {
	spi1_default: spi1-0 {
		pins1 {
			pinmux = <STM32_PINMUX('A', 5, AF5)>, /* SPI1_SCK */
				 <STM32_PINMUX('A', 6, AF5)>, /* SPI1_MISO */
				 <STM32_PINMUX('A', 7, AF5)>; /* SPI1_MOSI */
			bias-disable;
			drive-push-pull;
			slew-rate = <2>;
		};
	};

	usart1_default: usart1-0 {
		pins1 {
			pinmux = <STM32_PINMUX('A', 9, AF7)>, /* USART1_TX */
				 <STM32_PINMUX('A', 12, AF7)>; /* USART1_RTS */
			bias-disable;
			drive-push-pull;
			slew-rate = <2>;
		};

		pins2 {
			pinmux = <STM32_PINMUX('A', 10, AF7)>, /* USART1_RX */
				 <STM32_PINMUX('A', 11, AF7)>; /* USART1_CTS */
			bias-disable;
			slew-rate = <2>;
		};
	};

	usart3_default: usart3-0 {
		pins1 {
			pinmux = <STM32_PINMUX('C', 10, AF7)>; /* USART3_TX */
			bias-disable;
			drive-push-pull;
			slew-rate = <2>;
		};

		pins2 {
			pinmux = <STM32_PINMUX('C', 11, AF7)>; /* USART3_RX */
			bias-disable;
			slew-rate = <2>;
		};
	};
};
