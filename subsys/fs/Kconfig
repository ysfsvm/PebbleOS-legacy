menuconfig FS
    bool "File system"
    select TASK_WDT
    help
      Access to files on mounted file systems, regardless of their
      format.

if FS

config FS_PFS
    bool "Pebble File System (PFS)"
    select CRC
    default y
    help
      PFS, the wear-leveled file system on the external NOR flash.

config FS_PFS_PAGE_SIZE
    hex "PFS page size"
    depends on FS_PFS && FLASH_S29VS
    default 0x2000
    help
      Size of a PFS page, a fraction of the erase sector. The S29VS has
      8 KiB pages in its 128 KiB sectors, as in the stock firmware.
      Without it, a page is the flash subsector.

config FS_PFS_FORMAT_SECTOR_PAGES
    bool "Format a PFS written with one page per erase sector"
    depends on FS_PFS
    default y if FLASH_S29VS
    help
      At boot, format the filesystem when its page headers sit only at
      erase sector starts: it was written by a firmware whose page was
      the whole erase sector, and smaller pages cannot read its files.

config FS_PFS_CONVERT_SECTOR_PAGES
    bool "Convert a PFS written with one page per erase sector"
    depends on FS_PFS_FORMAT_SECTOR_PAGES
    help
      Instead of formatting such a filesystem, convert it at boot to the
      smaller pages, keeping its files. A conversion cut by a reset
      resumes at the next boot.

config FS_PFS_SHELL_LITTER
    bool "PFS litter shell command"
    depends on FS_PFS && SHELL
    help
      The pfs litter command, to fragment the file system for testing.

module = FS
module-str = File system
source "subsys/logging/Kconfig.template.log_level"

endif
