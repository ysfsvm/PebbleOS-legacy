menu "Bluetooth"

config BT
    bool "Bluetooth"
    select BTUTIL
    select MBEDTLS
    select TASK_WDT
    help
      The Bluetooth subsystem: the NimBLE host and the PebbleOS glue
      around it.

if BT

config BT_VENDOR_ID
    hex "Vendor ID"
    default 0x0EEA
    help
      Company identifier in the manufacturer data of advertisements.

config BT_VENDOR_NAME
    string "Vendor name"
    default "Core Devices LLC"
    help
      Manufacturer name in the Device Information Service.

config BT_HOST_THREAD_STACK_SIZE
    int "Host thread stack size in bytes"
    default 5000

config BT_HOST_THREAD_PRIO
    int "Host thread priority"
    default 3

config BT_LL_THREAD_STACK_SIZE
    int "Link layer thread stack size in bytes"
    default 1384

config BT_LL_THREAD_PRIO
    int "Link layer thread priority"
    default 4

config BT_HCI_THREAD_STACK_SIZE
    int "HCI transport thread stack size in bytes"
    default 1024

config BT_HCI_THREAD_PRIO
    int "HCI transport thread priority"
    default 3

choice BT_HCI
    prompt "HCI transport"
    default BT_HCI_FAKE
    help
      How the NimBLE host reaches its controller. The default is derived
      from the SoC (see each soc/<soc>/Kconfig.defconfig); the fake
      controller is the fallback where there is no radio.

config BT_HCI_NRF52
    bool "NimBLE controller on the nRF52 radio"
    depends on SOC_NRF52
    select NIMBLE_CONTROLLER
    select NIMBLE_DRIVER_NRF5X
    help
      Run the NimBLE link layer in the same image, on the nRF52 radio.

config BT_HCI_SF32LB52
    bool "SiFli LCPU over IPC"
    depends on SOC_SF32LB52
    select REMOTEPROC
    help
      Talk H4 HCI to the SiFli controller running on the LCPU, over the
      byte rings its ROM shares with the HCPU.

config BT_HCI_UART
    bool "H4 over UART"
    depends on QEMU || SOC_POSIX || SOC_STM32F4
    help
      Talk H4 HCI to an external controller over the board's BT_HCI_UART.
      On QEMU this is the fourth serial port, on native boards the -b
      option; either can be attached to a host controller such as an
      nRF52840 dongle running Zephyr's hci_uart.

config BT_HCI_FAKE
    bool "Fake controller"
    help
      Answer every HCI command locally with success and never raise an
      event. The host synchronises and the GATT server runs, but no link
      can be established. For targets without a radio, such as QEMU.

endchoice

config BT_HCI_UART_LEGACY
    bool
    depends on BT_HCI_UART
    default y if BT_CONTROLLER_CC2564
    help
      The legacy watches' H4 transport (transport/hci_uart_legacy.c in
      NimBLE's glue) in place of Core's: it boots and sets up the
      controller, runs its low-power UART protocol, puts the pinned
      resolvable private address in, and recovers a wedged controller.
      It drives the board's STM32 USART BOARD_BT_HCI_UART_DEV itself;
      the BT_HCI_UART role is not used.

config BT_OWN_SERVICE_CHANGED
    bool "Service Changed with a reconnect"
    default y if BT_CONTROLLER_CC2564
    help
      Indicate Service Changed after pairing, after an update that changed
      the attribute layout and after importing the stock pairing, then
      drop the link so the phone app reconnects with the new layout. The
      watches that share the filesystem with the stock firmware need it:
      phones keep the stock firmware's attribute cache otherwise.

choice BT_ID_ADDR_SOURCE
    prompt "Identity address"
    default BT_ID_ADDR_CONTROLLER
    help
      Where the watch's Bluetooth identity address comes from. The default
      is derived from the SoC (see each soc/<soc>/Kconfig.defconfig).

config BT_ID_ADDR_CONTROLLER
    bool "Controller"
    help
      Use the address the controller reports, or let NimBLE pick one.

config BT_ID_ADDR_SF32LB52_EFUSE
    bool "SF32LB52 eFUSE"
    depends on NVMEM_SF32LB52
    select BT_ID_ADDR
    help
      Public address derived from the unique ID in the SoC's eFUSE.

config BT_ID_ADDR_SERIAL
    bool "Random static address from the serial number"
    select BT_ID_ADDR
    help
      Derive a random static address from the watch's serial number on every
      boot, as the legacy DA14681 firmware did. It needs no storage, so it
      never changes, and matches the address the legacy firmware used.

config BT_ID_ADDR_STORAGE
    bool "Stored random static address"
    depends on SERVICE_SHARED_PRF_STORAGE
    select BT_ID_ADDR
    help
      Generate a random static address once and keep it in shared PRF
      storage, for controllers without an address of their own.

endchoice

config BT_ID_ADDR
    bool
    help
      An identity address backend is selected (pbl/bluetooth/id_addr.h).

config BT_ID_ADDR_PREFER_PUBLIC
    bool "Prefer the controller's public address"
    depends on BT_ID_ADDR
    help
      Use the public address the controller reports, when it has one, and
      the identity address source above only when it reports none. For
      controllers that some units ship with a factory address and others
      not.

module = BT
module-str = Bluetooth
source "subsys/logging/Kconfig.template.log_level"

config BT_REPEAT_PAIRING_ALWAYS
    bool "Always accept repeat pairing"
    help
      Forget the keys of a bonded peer that pairs again and accept it, even
      without secure connections and user confirmation. For firmware with
      no other way to forget a pairing.

config BT_HRM_SERVICE
    bool
    help
      The backend implements the Heart Rate Service
      (pbl/bluetooth/hrm_service.h).

rsource "services/Kconfig"

endif

endmenu
